---
import { Image } from "astro:assets";
import Layout from "../components/Layout.astro";
import RandomArtGadget from "../components/RandomArtGadget.astro";
import amitoWelcoming from "../assets/amito-welcoming.png";
---

<Layout>
  <div class="site-section">
    <div class="regular-paragraph">
      <h1>Welcome to Amito.cloud</h1>
      <p>
        It's really special to me that you decided to write up amito.cloud on
        your browser or alternatively just clicked the link to my website
        somewhere. You are a friend of mine now, whether you like it or not.
      </p>
    </div>
    <RandomArtGadget />

    <Image class="image-rounded-standard" src={amitoWelcoming} alt="" />
  </div>
</Layout>

<style>
  .site-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: min-content 1fr;
    gap: var(--space-medium);
  }

  .site-section .regular-paragraph {
    grid-column: 1;
    grid-row: 1;
    align-self: start;
    height: auto;
  }

  .site-section .art-gadget {
    grid-column: 1;
    grid-row: 2;
    width: 100%;
    height: 100%;
    min-height: 0;
    justify-self: stretch;
    align-self: stretch;
  }

  .site-section .image-rounded-standard {
    grid-column: 2;
    grid-row: 1 / 3;
    width: auto;
    max-width: 100%;
    height: 200vh;
  }

  @container (max-width: 650px) {
    .site-section .regular-paragraph {
      grid-column: 1 / 3;
      grid-row: 1;
    }

    .site-section .art-gadget {
      grid-column: 1;
      grid-row: 2;
    }

    .site-section .image-rounded-standard {
      grid-column: 2;
      grid-row: 2;
    }
  }
</style>
