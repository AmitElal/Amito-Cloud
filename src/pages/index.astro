---
import { Image } from "astro:assets";
import Layout from "../components/Layout.astro";
import templePhoto from "../assets/amit-in-japan-clounds-temple.jpg";
---

<Layout>
  <div class="site-section">
    <div class="regular-paragraph">
      <h1>Welcome to Amito.cloud</h1>
      <p>
        It's really special to me that you decided to write up amito.cloud on
        your browser or alternatively just clicked the link to my website
        somewhere. You are a friend of mine now, whether you like it or not.
      </p>
    </div>
    <Image class="image-rounded-standard" src={templePhoto} alt="" />
  </div>
</Layout>
