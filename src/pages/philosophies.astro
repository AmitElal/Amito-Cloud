---
import Layout from "../components/Layout.astro";

import Form from "../components/Form.astro";

const passwordFields = [
  {
    label: "Security Code",
    name: "page-password",
    type: "password",
    placeholder: "Enter secret phrase...",
  },
];
---

<Layout>
  <!-- 1. Password Lock Gate Screen using the shared Form component style -->
  <div id="password-gate">
    <Form
      title="Protected content"
      description="Please enter the password to view this philosophy notebook layout."
      formAction="javascript:void(0);"
      inputs={passwordFields}
      submitText="Unlock Content"
      formId="gate-form"
    >
      <p
        id="error-message"
        style="color: red; margin-top: 1rem; font-weight: bold; min-height: 1.2rem;"
      >
      </p>
    </Form>
  </div>

  <!-- 2. Secure Content Layer -->
  <div id="secure-content" style="display: none; padding: 2rem;">
    <h1>Philosophies</h1>
    <h2>Amito.Buddhism</h2>
    <p>It all started in the north of India...</p>
    <h2>Balanced Ambition</h2>
    <p>I want to use my skills...</p>
  </div>
</Layout>

<!-- Client-side Logic Script Box -->
<script>
  // Set your desired password here
  const CORRECT_PASSWORD = "amitoisthebest";

  // Crucial: 'astro:page-load' ensures this fires perfectly on initial load
  // AND whenever navigating via client-side links without a hard refresh.
  document.addEventListener("astro:page-load", () => {
    const passwordGate = document.getElementById("password-gate");
    const secureContent = document.getElementById("secure-content");
    const passwordInput = document.getElementById(
      "password-input",
    ) as HTMLInputElement;
    const unlockBtn = document.getElementById("unlock-btn");
    const errorMessage = document.getElementById("error-message");

    // Exit cleanly if we are on a page that doesn't render these password elements
    if (!passwordInput || !unlockBtn) return;

    function verifyPassword() {
      if (!passwordInput || !passwordGate || !secureContent || !errorMessage)
        return;

      if (passwordInput.value === CORRECT_PASSWORD) {
        passwordGate.style.display = "none";
        secureContent.style.display = "block";
      } else {
        errorMessage.textContent = "Incorrect password. Try again.";
        passwordInput.value = "";
      }
    }

    // Bind event hooks safely
    unlockBtn.addEventListener("click", verifyPassword);

    passwordInput.addEventListener("keypress", (e) => {
      if (e.key === "Enter") {
        verifyPassword();
      }
    });
  });
</script>
<style>
  /* Centers the password card exactly in the middle of the viewport */
  #password-gate {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 60vh;
    width: 100%;
    box-sizing: border-box;
  }

  .lock-box {
    background-color: rgb(60, 60, 60);
    padding: 2.5rem;
    text-align: center;
    max-width: 400px;
    width: 100%;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
  }

  .lock-box h2 {
    color: greenyellow;
    margin-top: 0;
    margin-bottom: 0.5rem;
  }

  .lock-box p {
    color: #ccc;
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
  }

  .input-group {
    display: flex;
    gap: 0.5rem;
  }

  .input-group input {
    flex-grow: 1;
    padding: 0.75rem 1rem;
    border: 2px solid #444;
    border-radius: 6px;
    background-color: #222;
    color: #fff;
    font-size: 1rem;
    outline: none;
    transition: border-color 0.2s;
  }

  .input-group input:focus {
    border-color: greenyellow;
  }

  .input-group button {
    padding: 0.75rem 1.5rem;
    background-color: greenyellow;
    border: none;
    /* border-radius: 10000px; */
    color: #222;
    font-weight: bold;
    font-size: 1rem;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .input-group button:hover {
    opacity: 0.9;
  }

  .error-msg {
    color: #ff5252 !important;
    margin-top: 1rem;
    margin-bottom: 0 !important;
    font-weight: 500;
    height: 1.2rem;
  }
</style>
