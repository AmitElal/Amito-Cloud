---
import Button from "../components/Button.astro";

import "../components/Header.css";

import amitoCloudIcon from "../assets/amito-cloud-icon.svg";
import pipeFront from "../assets/pipe-front.svg";
import pipeBack from "../assets/pipe-back.svg";
---

<header transition:persist>
  <a href="/" class="logo-container">
    <img src={amitoCloudIcon.src} alt="AMITO CLOUD Logo" />
  </a>

  <button id="menuToggle" class="menu-toggle" aria-label="Toggle navigation">
    <Button>
      <div class="hamburger-lines">
        <span></span>
        <span></span>
        <span></span>
      </div>
    </Button>
  </button>

  {/* Changed from <div> to native <dialog> */}
  <dialog id="navMenu" class="header-buttons-container">
    <a href="/contact"><Button>Contact</Button></a>
    <!-- <a href="/skills"><Button>Amito.Skillz</Button></a> -->
    <a href="/philosophies"><Button>Cloud.Vibes</Button></a>
    <a href="/visualart"><Button>Visual Art</Button></a>
  </dialog>

  <div class="vertical-line" style="right: 2rem; background-color: red"></div>
  <div class="vertical-line"></div>
  <div class="horizontal-line"></div>
  <div class="horizontal-line" style="top: 6.25rem; background-color: red;">
  </div>

  <div class="pipe-image-container">
    <img src={pipeFront.src} />
    <img src={pipeBack.src} style="z-index: -2;" />
  </div>
</header>

<script>
  const menuToggle = document.getElementById("menuToggle");
  const navMenu = document.getElementById(
    "navMenu",
  ) as HTMLDialogElement | null;

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;

    if (target.closest("#menuToggle")) {
      const isOpen = menuToggle?.classList.contains("open");

      if (isOpen) {
        menuToggle?.classList.remove("open");
        navMenu?.close();
        document.documentElement.classList.remove("lock-scroll");
      } else {
        menuToggle?.classList.add("open");
        navMenu?.showModal();
        document.documentElement.classList.add("lock-scroll");
      }
    }
  });

  navMenu?.addEventListener("close", () => {
    menuToggle?.classList.remove("open");
    document.documentElement.classList.remove("lock-scroll");
  });

  document.querySelectorAll(".header-buttons-container a").forEach((link) => {
    link.addEventListener("click", () => {
      menuToggle?.classList.remove("open");
      navMenu?.close();
      document.documentElement.classList.remove("lock-scroll");
    });
  });
</script>
